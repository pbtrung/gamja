	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"typecheck": "node node_modules/typescript7/bin/tsc --noEmit -p .",
		"lint": "eslint",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"coverage": "vitest run --coverage",
		"check": "npm run typecheck && npm run lint -- --max-warnings 0 && npm run format:check && npm test",
